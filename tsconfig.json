{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "evals/**/*.ts",
    "evals/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "vite.config.evals.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "apps/web/next-env.d.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/src/**/*.mts"
  ],
  "exclude": ["node_modules", "apps/landing", "apps/hero-video", "apps/web/.next"]
}
